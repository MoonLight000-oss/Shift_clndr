#:import dp kivy.metrics.dp
<ShiftDayButton>:
    background_normal: ''
    background_down: ''
    color: 0, 0, 0, 1
    bold: True
    font_size: dp(13)
    halign: 'center'
    valign: 'middle'
    text_size: self.size

<RoundedActionButton@Button>:
    size_hint_y: None
    height: dp(46)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: 0.06, 0.06, 0.08, 1
    bold: True
    font_size: dp(14)

    canvas.before:
        Color:
            rgba: 0.90, 0.91, 0.94, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20),]

<AccentActionButton@RoundedActionButton>:
    color: 1, 1, 1, 1

    canvas.before:
        Color:
            rgba: 0.19, 0.56, 0.95, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20),]

<DarkActionButton@RoundedActionButton>:
    color: 1, 1, 1, 1

    canvas.before:
        Color:
            rgba: 0.22, 0.24, 0.28, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20),]

<RoundedTextInput>:
    multiline: False
    readonly: False
    write_tab: False
    font_size: dp(15)
    padding: dp(16), dp(14)
    foreground_color: 0.05, 0.05, 0.07, 1
    disabled_foreground_color: 0.05, 0.05, 0.07, 1
    hint_text_color: 0.42, 0.44, 0.48, 1
    selection_color: 0.19, 0.56, 0.95, 0.35
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    cursor_color: 0.05, 0.05, 0.07, 1
    size_hint_y: None
    height: dp(52)

    canvas.before:
        Color:
            rgba: 0.92 if self.focus else 1, 0.97 if self.focus else 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18),]

<PatternTextInput>:
    multiline: True
    readonly: False
    write_tab: False
    font_size: dp(16)
    padding: dp(16), dp(14)
    foreground_color: 0.02, 0.02, 0.04, 1
    disabled_foreground_color: 0.02, 0.02, 0.04, 1
    hint_text_color: 0.38, 0.40, 0.44, 1
    selection_color: 0.19, 0.56, 0.95, 0.35
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    cursor_color: 0.02, 0.02, 0.04, 1
    size_hint_y: None
    height: dp(96)

    canvas.before:
        Color:
            rgba: 0.92 if self.focus else 1, 0.97 if self.focus else 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18),]

<RoundedSpinner@Spinner>:
    size_hint_y: None
    height: dp(46)
    color: 0.05, 0.05, 0.07, 1
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20),]

<CardPanel@BoxLayout>:
    orientation: 'vertical'
    spacing: dp(10)
    padding: dp(12)
    size_hint_y: None
    height: self.minimum_height

    canvas.before:
        Color:
            rgba: 0.12, 0.13, 0.15, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(24),]

<SectionTitle@Label>:
    size_hint_y: None
    height: dp(22)
    color: 1, 1, 1, 1
    bold: True
    font_size: dp(13)
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<CalendarAppRoot>:
    orientation: 'vertical'
    spacing: dp(10)
    padding: dp(10)

    canvas.before:
        Color:
            rgba: 0.08, 0.08, 0.09, 1
        Rectangle:
            pos: self.pos
            size: self.size

    CardPanel:
        size_hint_x: None
        width: root.width - dp(20) if root.width < dp(560) else dp(520)
        pos_hint: {'center_x': 0.5}
        spacing: dp(0)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)

            Label:
                font_name: root.ui_font_bold
                text: 'Календарь смен'
                color: 1, 1, 1, 1
                bold: True
                font_size: '17sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            RoundedTextInput:
                id: date_search_input
                font_name: root.ui_font_name
                text: '03.06.2026'
                font_size: dp(13)
                height: dp(40)
                size_hint_x: None
                width: dp(128)

            AccentActionButton:
                text: 'Найти'
                font_size: dp(12)
                height: dp(40)
                size_hint_x: None
                width: dp(72)
                on_release: root.find_date()

            Button:
                text: '▼' if root.controls_expanded else '▶'
                size_hint_x: None
                width: dp(48)
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                font_size: '20sp'
                bold: True

                canvas.before:
                    Color:
                        rgba: 0.22, 0.24, 0.28, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(18),]

                on_release: root.toggle_controls_panel()

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(6)
            scroll_type: ['bars']
            size_hint_y: None
            height: 0 if not root.controls_expanded else (dp(280) if controls_content.minimum_height > dp(280) else controls_content.minimum_height + dp(2))
            opacity: 1 if root.controls_expanded else 0

            BoxLayout:
                id: controls_content
                orientation: 'vertical'
                spacing: dp(10)
                padding: 0, dp(10), 0, dp(4)
                size_hint_y: None
                height: self.minimum_height

                Label:
                    id: selected_day_label
                    font_name: root.ui_font_bold
                    text: 'Выбранный день: нет'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(4)
                    color: 1, 1, 1, 1
                    bold: True
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None

                SectionTitle:
                    text: 'Отметка'

                PatternTextInput:
                    id: day_note_input
                    font_name: root.ui_font_name
                    font_size: dp(14)
                    height: dp(72)
                    text: root.selected_note_text()

                GridLayout:
                    cols: 1 if self.width < dp(420) else 2
                    size_hint_y: None
                    height: dp(100) if self.cols == 1 else dp(46)
                    spacing: dp(8)

                    AccentActionButton:
                        text: 'Сделать отметку'
                        on_release: root.save_day_note()

                    RoundedActionButton:
                        text: 'Удалить отметку'
                        on_release: root.clear_day_note()

                SectionTitle:
                    text: 'Смена для выбранного дня'

                GridLayout:
                    cols: 1 if self.width < dp(390) else 2
                    size_hint_y: None
                    height: dp(104) if self.cols == 1 else dp(46)
                    spacing: dp(8)

                    RoundedSpinner:
                        id: shift_spinner
                        text: 'День'
                        values: root.base_pattern

                    AccentActionButton:
                        text: 'Применить'
                        size_hint_x: 1
                        on_release: root.apply_selected_shift()

                BoxLayout:
                    size_hint_y: None
                    height: adjust_label.texture_size[1] + dp(8)
                    spacing: dp(8)

                    CheckBox:
                        id: adjust_following_checkbox
                        size_hint: None, None
                        size: dp(28), dp(28)
                        active: False
                        on_active: root.on_auto_adjust_toggle(self.active)

                    Label:
                        id: adjust_label
                        font_name: root.ui_font_name
                        text: 'Менять остальные смены после изменения одной'
                        color: 0.92, 0.93, 0.96, 1
                        font_size: dp(13)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None

                Label:
                    font_name: root.ui_font_name
                    text: 'Если включить, график после ручного дня или диапазона продолжится от последней выбранной смены.'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(6)
                    color: 0.72, 0.75, 0.80, 1
                    font_size: dp(12)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None

                SectionTitle:
                    text: 'Быстрые действия'

                GridLayout:
                    cols: 1 if self.width < dp(430) else 2
                    size_hint_y: None
                    height: dp(212) if self.cols == 1 else dp(100)
                    spacing: dp(8)

                    AccentActionButton:
                        text: 'Сегодня'
                        on_release: root.go_to_today()

                    DarkActionButton:
                        text: 'Сохранить'
                        on_release: root.save_state()

                    RoundedActionButton:
                        text: 'Сбросить день'
                        on_release: root.clear_selected_day()

                    RoundedActionButton:
                        text: 'Сбросить всё'
                        on_release: root.clear_all_manual_shifts()

                SectionTitle:
                    text: 'Диапазон'

                GridLayout:
                    cols: 1 if self.width < dp(420) else 2
                    size_hint_y: None
                    height: dp(112) if self.cols == 1 else dp(52)
                    spacing: dp(8)

                    RoundedTextInput:
                        id: start_input
                        font_name: root.ui_font_name
                        hint_text: 'Старт (дд.мм.гггг)'
                        text: root.default_start_text()

                    RoundedTextInput:
                        id: end_input
                        font_name: root.ui_font_name
                        hint_text: 'Конец (дд.мм.гггг)'
                        text: root.default_end_text()

                PatternTextInput:
                    id: range_pattern_input
                    font_name: root.ui_font_name
                    hint_text: 'Режим диапазона: День, Ночь, Ночь, День'
                    text: 'День,Ночь,Ночь,День'

                GridLayout:
                    cols: 1 if self.width < dp(420) else 2
                    size_hint_y: None
                    height: dp(100) if self.cols == 1 else dp(46)
                    spacing: dp(8)

                    RoundedActionButton:
                        text: 'Применить диапазон'
                        on_release: root.apply_range_shift()

                    DarkActionButton:
                        text: 'Отпуск'
                        on_release: root.apply_vacation_range()

                Label:
                    id: info_label
                    font_name: root.ui_font_name
                    text: 'Выбери день, затем смену. Диапазон задаётся отдельным блоком.'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(8)
                    color: 1, 1, 1, 1
                    font_size: dp(12)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None

    ScrollView:
        id: months_scroll
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(8)
        scroll_type: ['bars', 'content']
        on_scroll_y: root.on_scroll_y(self, self.scroll_y)

        BoxLayout:
            id: months_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(12)
            padding: 0, 0, 0, dp(20)
